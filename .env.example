# Salin menjadi .env.development (lokal) atau .env.production (build produksi), lalu isi nilainya.
# Nilai ini bukan rahasia (aplikasi SPA), tetapi tidak disimpan di repositori.
VITE_MSAL_CLIENT_ID=<Application (client) ID dari app registration di Microsoft Entra ID>
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/<Directory (tenant) ID>
# Email yang selalu dianggap Admin (pisahkan dengan koma).
VITE_ADMIN_EMAILS=<email-admin>@waskitainfrastruktur.co.id
